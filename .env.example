[TEMPLATE]
# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny_dev_password
POSTGRES_DB=lenny_growth_assistant
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lenny:lenny_dev_password@postgres:5432/lenny_growth_assistant

# Transcript Source
TRANSCRIPTS_DIR=./knowledge-source/lennys-podcast-transcripts/episodes

# LLM Provider
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60

# OpenAI Cloud Provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic Cloud Provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini Cloud Provider
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Embeddings
# "ollama" keeps the demo fully local (requires nomic-embed-text model).
# "openai" requires OPENAI_API_KEY (text-embedding-3-small).
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=60

# Ingestion Tuning
INGESTION_BATCH_SIZE=32
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=150
