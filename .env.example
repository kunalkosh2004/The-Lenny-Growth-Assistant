# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny_dev_password
POSTGRES_DB=lenny_growth_assistant
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lenny:lenny_dev_password@postgres:5432/lenny_growth_assistant

# Transcript Source
TRANSCRIPTS_DIR=./knowledge-source/lennys-podcast-transcripts/episodes

# LLM Provider
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60

# OpenAI Cloud Provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_DIMENSIONS=1536
